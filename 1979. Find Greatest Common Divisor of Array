// 1979. Find Greatest Common Divisor of Array

class Solution {
    public int findGCD(int[] nums) {
        
        int smallest = nums[0];
        int largest = nums[0];
        
        // Find smallest and largest
        for (int i = 1; i < nums.length; i++) {
            if (nums[i] < smallest) {
                smallest = nums[i];
            }
            
            if (nums[i] > largest) {
                largest = nums[i];
            }
        }
        
        // Find GCD
        while (largest % smallest != 0) {
            int remainder = largest % smallest;
            largest = smallest;
            smallest = remainder;
        }
        
        return smallest;
    }
}
